# ==============================================================================
# PACTIO - CONFIGURACIÓN DE ENTORNO (TEMPLATE SEGURO)
# Copia este archivo como .env para desarrollo local o despliegue en producción.
# NUNCA subas el archivo .env con valores reales al control de versiones.
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Clave Secreta para Magic Links y Firmas HMAC-SHA256
# En producción, genera un secreto de alta entropía ejecutando: openssl rand -hex 32
MAGIC_LINK_SECRET=pactio_secure_dev_secret_replace_in_production_32b

# Prestador de Servicios de Certificación (PSC) Acreditado NOM-151 (Opcional)
# Si no se provee, Pactio opera en modo Sandbox Cero-Conocimiento local.
PSC_NOM151_API_URL=https://api.sandbox-psc.economia.gob.mx/v1
PSC_NOM151_API_KEY=psc_sandbox_test_key_sample_only
